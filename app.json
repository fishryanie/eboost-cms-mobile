{
  "expo": {
    "name": "Eboost CMS",
    "slug": "cms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "eboostcmsmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/images/icon.png",
      "bundleIdentifier": "com.evida.eboost.cms",
      "buildNumber": "10",
      "infoPlist": {
        "CFBundleDisplayName": "Eboost CMS",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./src/assets/images/icon.png",
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./src/assets/images/cms-splash.png",
          "resizeMode": "cover",
          "ios": {
            "enableFullScreenImage_legacy": true
          },
          "android": {
            "image": "./src/assets/images/cms-splash.png",
            "backgroundColor": "#FFFFFF",
            "resizeMode": "cover"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Eboost CMS to use Face ID for secure admin sign in."
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Eboost CMS to access your photos so you can upload location images."
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "26625cb7-5cd2-42c2-97d4-5aecd7e83ffb"
      }
    },
    "owner": "eboost-cms"
  }
}
