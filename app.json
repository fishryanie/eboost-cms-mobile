{
  "expo": {
    "name": "Eboost CMS",
    "slug": "cms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "eboostcmsmobile",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./src/assets/images/icon.png",
      "bundleIdentifier": "com.evida.eboost.cms",
      "buildNumber": "2",
      "infoPlist": {
        "CFBundleDisplayName": "Eboost CMS",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./src/assets/images/icon.png",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.evida.eboost.cms"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./src/assets/images/cms-splash.png",
          "resizeMode": "cover",
          "ios": {
            "enableFullScreenImage_legacy": true
          },
          "android": {
            "image": "./src/assets/images/cms-splash.png",
            "backgroundColor": "#FFFFFF",
            "resizeMode": "cover"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Eboost CMS to use Face ID for secure admin sign in."
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Eboost CMS to access your photos so you can upload location images."
        }
      ],
      "expo-image",
      "expo-asset",
      "./plugins/withGradleProperties",
      [
        "@sentry/react-native/expo",
        {
          "organization": "your-sentry-org",
          "project": "your-sentry-project"
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "26625cb7-5cd2-42c2-97d4-5aecd7e83ffb"
      }
    },
    "owner": "eboost-cms",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/26625cb7-5cd2-42c2-97d4-5aecd7e83ffb",
      "checkAutomatically": "NEVER"
    }
  }
}
